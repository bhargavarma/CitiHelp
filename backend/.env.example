# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env or any real secrets.

# Database (Supabase PostgreSQL in production; SQLite is used locally by default)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini (backend only; leave blank to use the deterministic knowledge-base fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# Optional admin bootstrap. An administrator is only created when both values are set.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=System Administrator

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

